# ============================================================
# SkillTech Hub — Local Dev .env (XAMPP / Windows)
# ============================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# JWT — change these to any long random strings
JWT_SECRET=skilltech-local-jwt-secret-key-minimum-64-characters-long-abc123
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=skilltech-local-refresh-secret-key-minimum-64-chars-long-xyz789
JWT_REFRESH_EXPIRES_IN=30d

# ── Database (XAMPP defaults) ──────────────────────────────

DB_POOL_MIN=2
DB_POOL_MAX=10

NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skilltech_hub
DB_USER=root
DB_PASSWORD=

CLIENT_URL=http://localhost:5173

JWT_SECRET=mysupersecret
JWT_REFRESH_SECRET=myrefreshsecret

# ── Redis ──────────────────────────────────────────────────
# If you don't have Redis, the app will warn but still run
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=


VITE_API_URL=https://skilltech-hub-backend-production.up.railway.app

# ── Cloudinary (optional for dev — uploads will use placeholders) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Livekit (optional for dev — live classes won't work without it) ──
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Payments (optional for dev) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# ── Email / Resend (optional for dev — emails log to console) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@skilltechhub.com
EMAIL_FROM_NAME=SkillTech Hub

# ── AI Tutor (optional for dev — AI routes won't work without it) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
AI_MODEL=claude-haiku-4-5-20251001

# ── OAuth (optional for dev) ─────────────────────────────
# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AWS S3 (optional) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=skilltech-recordings
