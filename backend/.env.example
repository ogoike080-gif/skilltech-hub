# ============================================================
# SkillTech Hub — Local Dev .env (XAMPP / Windows)
# ============================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# JWT — change these to any long random strings
JWT_SECRET=skilltech-local-jwt-secret-key-minimum-64-characters-long-abc123
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=skilltech-local-refresh-secret-key-minimum-64-chars-long-xyz789
JWT_REFRESH_EXPIRES_IN=30d

# Database (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skilltech_hub
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Livekit (optional)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Payments (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Email / Resend (optional)
RESEND_API_KEY=
EMAIL_FROM=noreply@skilltechhub.com
EMAIL_FROM_NAME=SkillTech Hub

# AI Tutor (optional)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
AI_MODEL=claude-haiku-4-5-20251001

# OAuth (optional)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=skilltech-recordings
